# Runtime data bind-mounted on the server: it changes between deploys, so
# sending it would bloat the build context and invalidate the source layer
/uploads
/images
/logs
/data
/pgdata*
/meilisearch*

# Specific patterns to ignore
data-node
meili_data*
librechat*
Dockerfile*
docs

# Ignore all hidden files
.*
